{
  "name": "kiro-session-finder",
  "version": "2.0.0",
  "description": "AI-powered semantic search for Kiro CLI chat sessions",
  "main": "main.js",
  "author": "Kiro Session Finder",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@xenova/transformers": "2.17.2",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "dev.kiro.session-finder",
    "productName": "Kiro Session Finder",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "select.js",
      "ai.js",
      "config.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.{md,markdown,map}",
      "!node_modules/**/{test,tests,__tests__,example,examples,docs,doc}/**",
      "!**/*.{o,obj,h,hpp,cc,cpp}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@xenova/transformers/dist/*.wasm",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "artifactName": "KiroSessionFinder-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "KiroSessionFinder-${version}.${ext}"
    }
  }
}
